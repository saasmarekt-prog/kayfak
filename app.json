{
  "expo": {
    "name": "كيفك",
    "slug": "kayfak",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "extra": {
      "defaultLocale": "ar",
      "layoutDirection": "rtl"
    },
    "android": {
      "package": "com.kayfak.app",
      "adaptiveIcon": {
        "backgroundColor": "#101827"
      }
    },
    "ios": {
      "bundleIdentifier": "com.kayfak.app",
      "supportsTablet": true
    },
    "plugins": [
      "expo-asset",
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc"
    ]
  }
}
